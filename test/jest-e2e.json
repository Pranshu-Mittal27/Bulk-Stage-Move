{
  "preset": "ts-jest/presets/default-esm",
  "testEnvironment": "node",
  "testRegex": ".*\\.e2e-spec\\.ts$",
  "extensionsToTreatAsEsm": [".ts"],
  "moduleNameMapper": {
    "^(\\.{1,2}/.*)\\.js$": "$1"
  },
  "transform": {
    "^.+\\.ts$": ["ts-jest", { "useESM": true, "tsconfig": "tsconfig.json" }]
  }
}
